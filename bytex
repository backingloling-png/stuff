-- FIXED: Ultimate Script Loader (Loads built-in AND Workspace scripts)
local function ReloadScripts()
	for _, child in ipairs(ScriptsList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local function createScriptButton(scriptName, fileContent)
		local item = Instance.new("TextButton")
		item.Size = UDim2.new(1, 0, 0, 25)
		item.Text = "  " .. scriptName
		item.Font = Enum.Font.Code
		item.TextSize = 13
		item.TextXAlignment = Enum.TextXAlignment.Left
		item.BackgroundTransparency = 1
		registerTheme(item, "text_color", "TextColor3")
		item.Parent = ScriptsList
		
		item.MouseButton1Click:Connect(function()
			CodeEditor.Text = fileContent
			LogMessage("[System] Loaded " .. scriptName .. " into editor.")
		end)
	end

	-- 1. Load Hardcoded Built-In Scripts
	for _, scriptData in ipairs(builtInScripts) do
		createScriptButton(scriptData.name, scriptData.content)
	end

	-- 2. Dynamically Load from Executor Workspace (For huge files)
	if listfiles and readfile then
		local success, files = pcall(function() return listfiles("") end)
		if success and type(files) == "table" then
			for _, filePath in ipairs(files) do
				if filePath:match("%.lua$") or filePath:match("%.txt$") then
					local fileName = filePath:match("([^/\\]+)$") or filePath
					local successRead, content = pcall(function() return readfile(filePath) end)
					if successRead then
						createScriptButton(fileName, content)
					end
				end
			end
		end
	end
	
	applyThemeColors()
end

