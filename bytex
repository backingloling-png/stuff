local function ExecuteCode()
	if not isLoaded then
		LogMessage("[System] Please press LOAD to inject ByteX before executing scripts.")
		return
	end

	local code = CodeEditor.Text
	if code == "" or code == "-- Welcome to ByteX" then
		LogMessage("[Executor] Cannot execute empty script.")
		return
	end
	
	if not loadstring then
		LogMessage("[ERROR] Your executor (Potassium) does not support 'loadstring'.")
		LogMessage("[INFO] Please use the executor's built-in script execution feature instead.")
		return
	end
	
	local success, err = pcall(function()
		local func, compileErr = loadstring(code)
		if func then
			func()
		else
			error(compileErr or "Failed to compile script")
		end
	end)
	
	if not success then
		LogMessage("[Executor] Script did not execute.")
