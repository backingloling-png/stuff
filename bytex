local function applyThemeColors()
	for colorType, elements in pairs(themedElements) do
		for _, data in ipairs(elements) do
			data.element[data.prop] = currentTheme[colorType]
		end
	end
	
	TabExecutor.BackgroundColor3 = currentTheme[currentTab == "Executor" and "bg_white" or "bg_gray"]
	TabAdmin.BackgroundColor3 = currentTheme[currentTab == "Admin" and "bg_white" or "bg_gray"]
	
	TitleIcon.Image = isDarkMode and LOGO_DARK or LOGO_LIGHT
	OpenButton.Image = isDarkMode and LOGO_DARK or LOGO_LIGHT
end

