UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainWindow.Position = UDim2.new(dragStartPos.X.Scale, dragStartPos.X.Offset + delta.X, dragStartPos.Y.Scale, dragStartPos.Y.Offset + delta.Y)
	end
	
	if input == resizeInput and resizingMode then
		local delta = input.Position - resizeStart
		local newWidth, newHeight, widthDiff
		
		if resizingMode == "BR" then
			newWidth = math.max(500, startSize.X.Offset + delta.X)
			newHeight = math.max(350, startSize.Y.Offset + delta.Y)
			MainWindow.Size = UDim2.new(0, newWidth, 0, newHeight)
			
		elseif resizingMode == "BL" then
			newWidth = math.max(500, startSize.X.Offset - delta.X)
			newHeight = math.max(350, startSize.Y.Offset + delta.Y)
			widthDiff = newWidth - startSize.X.Offset
			MainWindow.Size = UDim2.new(0, newWidth, 0, newHeight)
			MainWindow.Position = UDim2.new(resizeStartPos.X.Scale, resizeStartPos.X.Offset - widthDiff, resizeStartPos.Y.Scale, resizeStartPos.Y.Offset)
			
		elseif resizingMode == "R" then
			newWidth = math.max(500, startSize.X.Offset + delta.X)
			MainWindow.Size = UDim2.new(0, newWidth, 0, startSize.Y.Offset)
			
		elseif resizingMode == "L" then
			newWidth = math.max(500, startSize.X.Offset - delta.X)
			widthDiff = newWidth - startSize.X.Offset
			MainWindow.Size = UDim2.new(0, newWidth, 0, startSize.Y.Offset)
			MainWindow.Position = UDim2.new(resizeStartPos.X.Scale, resizeStartPos.X.Offset - widthDiff, resizeStartPos.Y.Scale, resizeStartPos.Y.Offset)
			
		elseif resizingMode == "B" then
			newHeight = math.max(350, startSize.Y.Offset + delta.Y)
			MainWindow.Size = UDim2.new(0, startSize.X.Offset, 0, newHeight)
		end
	end
end)

