end)
TitleBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)

local resizingMode = nil
local resizeInput, resizeStart, startSize, resizeStartPos

local function createResizeHitbox(name, size, pos, cursorIcon, resizeMode)
	local hitbox = Instance.new("TextButton")
	hitbox.Name = name
	hitbox.Size = size
	hitbox.Position = pos
	hitbox.BackgroundTransparency = 1
	hitbox.Text = ""
	hitbox.ZIndex = 100
	hitbox.Parent = MainWindow
	
	hitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not isMinimized then
			resizingMode = resizeMode
			resizeStart = input.Position
			startSize = MainWindow.Size
			resizeStartPos = MainWindow.Position
			
			local endConn
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then 
					resizingMode = nil 
					endConn:Disconnect()
				end
			end)
		end
	end)
	
	hitbox.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then resizeInput = input end
	end)
	
	return hitbox
end

