local function runScript(code, scriptName)
    if not injected then 
        consoleLog("error: please inject first!")
        return 
    end
    if code == "" or code == " " then return end
    
    local fn, err = loadstring(code)
    if fn then
        local env = setmetatable({}, {
            __index = function(t, k)
                return getfenv(0)[k]
            end
        })
        env.print = function(...)
            local args = {...}
            local str = {}
            for i, v in ipairs(args) do table.insert(str, tostring(v)) end
            consoleLog("[print] " .. table.concat(str, " "))
            getfenv(0).print(...)
        end
        env.warn = function(...)
            local args = {...}
            local str = {}
            for i, v in ipairs(args) do table.insert(str, tostring(v)) end
            consoleLog("<font color=\"#ffaa00\">[warn] " .. table.concat(str, " ") .. "</font>")
            getfenv(0).warn(...)
        end
        env.error = function(msg, level)
            consoleLog("<font color=\"#ff0000\">[error] " .. tostring(msg) .. "</font>")
            getfenv(0).error(msg, level or 1)
        end
        setfenv(fn, env)

        local runThread = task.spawn(function()
            local s, execErr = pcall(fn)
            if s then
                if not settingsData.noExecutorOutput then 
                    consoleLog("executed " .. string.lower(scriptName or "script") .. "!") 
                end
            else
                consoleLog("<font color=\"#ff0000\">runtime error in " .. string.lower(scriptName or "script") .. ": " .. string.lower(tostring(execErr)) .. "</font>")
            end
        end)
        table.insert(runningThreads, runThread)
    else
        consoleLog("<font color=\"#ff0000\">compile error in " .. string.lower(scriptName or "script") .. ": " .. string.lower(tostring(err)) .. "</font>")
    end
end

