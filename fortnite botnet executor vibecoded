-- Allow clicking anywhere in the empty space of the editor to focus the correct line/chunk
local function handleEditorClick(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local canvasY = (input.Position.Y - EditorScroll.AbsolutePosition.Y) + EditorScroll.CanvasPosition.Y
        
        local targetChunk = nil
        local currentY = 0
        for _, chunk in ipairs(chunkFrames) do
            local height = chunk.Frame.Size.Y.Offset
            if canvasY >= currentY and canvasY <= currentY + height then
                targetChunk = chunk
                break
            end
            currentY = currentY + height
        end
        
        if not targetChunk and #chunkFrames > 0 then
            targetChunk = chunkFrames[#chunkFrames]
        end
        
        if targetChunk and targetChunk.TextBox then
            targetChunk.TextBox:CaptureFocus()
            targetChunk.TextBox.CursorPosition = #targetChunk.TextBox.Text + 1
        end
    end
end

