            renameBox.Visible = false
            if renameBox.Text ~= "" then
                tData.name = renameBox.Text
            end
            renderTabs()
        end)

        btn.MouseButton1Click:Connect(function()
            if tabsData[currentTabIndex] then
                tabsData[currentTabIndex].content = getFullText()
            end
            currentTabIndex = i
            renderTabs()
            renderChunks(tabsData[currentTabIndex].content)
        end)
        
        closeTabBtn.MouseButton1Click:Connect(function()
            if #tabsData <= 1 then return end
            table.remove(tabsData, i)
            if currentTabIndex > #tabsData then
                currentTabIndex = #tabsData
            elseif currentTabIndex == i then
                -- stays the same index, which is now the next tab
            elseif currentTabIndex > i then
                currentTabIndex = currentTabIndex - 1
            end
            saveTabs()
            renderTabs()
            renderChunks(tabsData[currentTabIndex] and tabsData[currentTabIndex].content or "")
        end)
    end
    
    ScrollTabs.CanvasSize = UDim2.new(0, UIListLayout.AbsoluteContentSize.X, 0, 0)
end

function loadTabs()
    local s, data = pcall(function() return readfile(TABS_FILE) end)
    if s and data then
        local p, d = pcall(function() return HttpService:JSONDecode(data) end)
        if p and type(d) == "table" and #d > 0 then
            tabsData = d
        else
            tabsData = {{name = "script.lua", content = ""}}
        end
    else
        tabsData = {{name = "script.lua", content = ""}}
    end
    currentTabIndex = 1
end

AddTabBtn.MouseButton1Click:Connect(function()
    if tabsData[currentTabIndex] then
        tabsData[currentTabIndex].content = getFullText()
        saveTabs()
    end
    tabCounter = tabCounter + 1
    table.insert(tabsData, {name = "script_" .. tabCounter .. ".lua", content = ""})
    currentTabIndex = #tabsData
    saveTabs()
    renderTabs()
    renderChunks("")
end)



loadTabs()
renderChunks(tabsData[currentTabIndex] and tabsData[currentTabIndex].content or "")
renderTabs()
refreshScriptList()

if not settingsData.noExecutorOutput then
    print("[fortnite botnet executor] loaded safely!")
end
