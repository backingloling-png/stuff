local CHUNK_LINES = 500
local chunkFrames = {}
local isRechunking = false
local focusedTextBox = nil
local focusedChunk = nil

getFullText = function()
    local res = {}
    for _, chunk in ipairs(chunkFrames) do
        table.insert(res, chunk.TextBox.Text)
    end
    return table.concat(res, "\n")
end

local function splitIntoChunks(text)
    local chunks = {}
    local currentChunk = {}
    local lineCount = 0
    
    local start = 1
    while true do
        local pos = text:find("\n", start, true)
        if pos then
            table.insert(currentChunk, text:sub(start, pos - 1))
            lineCount = lineCount + 1
            if lineCount >= CHUNK_LINES then
                table.insert(chunks, table.concat(currentChunk, "\n"))
                currentChunk = {}
                lineCount = 0
            end
            start = pos + 1
        else
            table.insert(currentChunk, text:sub(start))
            table.insert(chunks, table.concat(currentChunk, "\n"))
            break
        end
    end
    
    if #chunks == 0 then chunks = {""} end
    return chunks
end

local function updateAllLineNumbers()
    local currentStart = 1
    for _, chunkData in ipairs(chunkFrames) do
        chunkData.startingLine = currentStart
        local text = chunkData.TextBox.Text
        local newlines = 0
        for _ in text:gmatch("\n") do newlines = newlines + 1 end
        
        local linesStr = tostring(currentStart)
        for i = 1, newlines do 
            linesStr = linesStr .. "\n" .. tostring(currentStart + i) 
        end
        chunkData.LinesBox.Text = linesStr
        currentStart = currentStart + newlines + 1
    end
end

local function updateChunkHighlighting(chunkData)
    local text = chunkData.TextBox.Text
    local newlines = 0
    for _ in text:gmatch("\n") do newlines = newlines + 1 end
    
    local canvasHeight = (newlines + 1) * 14
    local bounds = TextService:GetTextSize(text, 14, Enum.Font.RobotoMono, Vector2.new(10000, 10000))
    local canvasWidth = bounds.X + 100
    
    chunkData.Frame.Size = UDim2.new(0, canvasWidth, 0, canvasHeight)
    chunkData.LinesBox.Size = UDim2.new(0, 30, 0, canvasHeight)
    chunkData.LineDivider.Size = UDim2.new(0, 1, 0, canvasHeight)
    chunkData.SyntaxLabel.Size = UDim2.new(0, canvasWidth, 0, canvasHeight)
    chunkData.TextBox.Size = UDim2.new(0, canvasWidth, 0, canvasHeight)
    
    -- PREVENT FREEZING ON MINIFIED / FREECAM SCRIPTS:
    if #text > 12000 then
        chunkData.SyntaxLabel.RichText = false
        chunkData.SyntaxLabel.Text = text
        return
    end
    
    chunkData.SyntaxLabel.RichText = true
    local hl = text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    local strings, comments = {}, {}
    hl = hl:gsub('(["\'])(.-)%1', function(q, inner)
        table.insert(strings, '<font color="#a31515">' .. q .. inner .. q .. '</font>')
        return "\1" .. string.rep("A", #strings) .. "\1"
    end)
    hl = hl:gsub('%-%-[^\n]*', function(com)
        table.insert(comments, '<font color="#008000">' .. com .. '</font>')
        return "\2" .. string.rep("A", #comments) .. "\2"
    end)
    local keywords = {"and", "break", "do", "else", "elseif", "end", "false", "for", "function", "if", "in", "local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while"}
    for _, kw in ipairs(keywords) do
        hl = hl:gsub("%f[%a]" .. kw .. "%f[^%a]", '<font color="#0000ff">' .. kw .. '</font>')
    end
    hl = hl:gsub("%f[%w]%d+%.?%d*%f[^%w]", '<font color="#098658">%0</font>')
    hl = hl:gsub('\2(A+)\2', function(alphas) return comments[#alphas] end)
    hl = hl:gsub('\1(A+)\1', function(alphas) return strings[#alphas] end)
    
    if text:sub(-1) == "\n" then hl = hl .. " " end
    chunkData.SyntaxLabel.Text = hl
end

local function getLineAndCol(text, pos)
    if pos == -1 then pos = #text + 1 end
    local before = text:sub(1, pos - 1)
    local _, newlines = before:gsub("\n", "")
    local lastLineStart = before:match(".*()\n")
    if not lastLineStart then lastLineStart = 0 end
    local colText = before:sub(lastLineStart + 1)
    return newlines, colText
end

-- ==========================================
-- MATHEMATICALLY PERFECT SPACE CALCULATION
-- ==========================================
local SPACE_WIDTH = 8
pcall(function()
    SPACE_WIDTH = TextService:GetTextSize("A A", 14, Enum.Font.RobotoMono, Vector2.new(10000, 10000)).X - TextService:GetTextSize("AA", 14, Enum.Font.RobotoMono, Vector2.new(10000, 10000)).X
end)
if SPACE_WIDTH <= 0 then SPACE_WIDTH = 8 end

local function measureTextWidth(txt)
    if txt == "" then return 0 end
    
    local trailingSpaces = 0
    for i = #txt, 1, -1 do
        if txt:sub(i, i) == " " then
            trailingSpaces = trailingSpaces + 1
        else
            break
        end
    end
    
    local stripped = txt:sub(1, #txt - trailingSpaces)
    local width = 0
    
    if #stripped > 0 then
        width = TextService:GetTextSize(stripped, 14, Enum.Font.RobotoMono, Vector2.new(10000, 10000)).X
    end
    
    return width + (trailingSpaces * SPACE_WIDTH)
end

local function updateCursor()
    pcall(function()
        if not focusedTextBox or not focusedChunk then return end
        local pos = focusedTextBox.CursorPosition
        local newlines, colText = getLineAndCol(focusedTextBox.Text, pos)
        local charX = measureTextWidth(colText)
        Cursor.Parent = focusedChunk.Frame
        Cursor.Position = UDim2.new(0, charX + 35, 0, newlines * 14)
    end)
end

local function updateSelection()
    pcall(function()
        for _, child in ipairs(SelectionContainer:GetChildren()) do child:Destroy() end
        if not focusedTextBox or not focusedChunk then return end
        
        local selStart = focusedTextBox.SelectionStart
        local cursorPos = focusedTextBox.CursorPosition
        if selStart == -1 or selStart == cursorPos then return end
        
        local startIdx = math.min(selStart, cursorPos)
        local endIdx = math.max(selStart, cursorPos)
        local text = focusedTextBox.Text
        local startLine, startColText = getLineAndCol(text, startIdx)
        local endLine, endColText = getLineAndCol(text, endIdx)
        
        SelectionContainer.Parent = focusedChunk.Frame
        
        for line = startLine, endLine do
            local frame = Instance.new("Frame")
            frame.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
            frame.BackgroundTransparency = 0.5
            frame.BorderSizePixel = 0
            frame.ZIndex = 3
            frame.Parent = SelectionContainer
            
            if startLine == endLine then
                local startX = measureTextWidth(startColText)
                local endX = measureTextWidth(endColText)
                frame.Position = UDim2.new(0, startX + 35, 0, line * 14)
                frame.Size = UDim2.new(0, endX - startX, 0, 14)
            elseif line == startLine then
                local startX = measureTextWidth(startColText)
                local lineText = text:sub(startIdx):match("([^\n]*)") or ""
                local endX = measureTextWidth(startColText .. lineText)
                frame.Position = UDim2.new(0, startX + 35, 0, line * 14)
                frame.Size = UDim2.new(0, endX - startX + 10, 0, 14)
            elseif line == endLine then
                local endX = measureTextWidth(endColText)
                frame.Position = UDim2.new(0, 35, 0, line * 14)
                frame.Size = UDim2.new(0, endX, 0, 14)
            else
                frame.Position = UDim2.new(0, 35, 0, line * 14)
                frame.Size = UDim2.new(0, 2000, 0, 14)
            end
        end
    end)
end

local function getCurrentWord()
    if not focusedTextBox then return end
    local text = focusedTextBox.Text
    local pos = focusedTextBox.CursorPosition
    if pos == -1 then pos = #text + 1 end
    local before = text:sub(1, pos - 1)
    local word = before:match("[%a_][%w_]*$")
    return word, pos
end

local function checkAutocomplete()
