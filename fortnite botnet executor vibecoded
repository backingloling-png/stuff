local function getRandomMotd()
    local keywords = {"eugene", "mossad", "skid", "paste", "jjsploit", "v3rmillion", "solara", "evon", "wearedevs", "proverb"}
    -- Artificially weight RNG: Try up to 50 times to pull a string with preferred keywords
    for i = 1, 50 do
        local str = motds[math.random(1, #motds)]
        local lowerStr = string.lower(str)
        for _, kw in ipairs(keywords) do
            if string.find(lowerStr, kw) then
                return str
            end
        end
    end
    -- Fallback if somehow none are found in 50 tries
    return motds[math.random(1, #motds)]
end
