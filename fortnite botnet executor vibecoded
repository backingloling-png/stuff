local function handleBoundary(input, chunkData)
    local tb = chunkData.TextBox
    if input.KeyCode == Enum.KeyCode.Backspace and tb.CursorPosition == 1 and tb.SelectionStart == -1 then
        if chunkData.index > 1 then
            local prevChunk = chunkFrames[chunkData.index - 1]
            local newCursorPos = #prevChunk.TextBox.Text + 1
            
            local chunksText = {}
            for _, f in ipairs(chunkFrames) do table.insert(chunksText, f.TextBox.Text) end
            local result = ""
            for i, t in ipairs(chunksText) do
                if i > 1 then
                    if i == chunkData.index then
                    else result = result .. "\n" end
                end
                result = result .. t
            end
            
            renderChunks(result)
            local newPrev = chunkFrames[chunkData.index - 1]
            if newPrev then
                newPrev.TextBox:CaptureFocus()
                newPrev.TextBox.CursorPosition = newCursorPos
            end
        end
    elseif input.KeyCode == Enum.KeyCode.Delete and tb.CursorPosition == #tb.Text + 1 and tb.SelectionStart == -1 then
        if chunkData.index < #chunkFrames then
            local curPos = tb.CursorPosition
            local chunksText = {}
            for _, f in ipairs(chunkFrames) do table.insert(chunksText, f.TextBox.Text) end
            local result = ""
            for i, t in ipairs(chunksText) do
                if i > 1 then
                    if i == chunkData.index + 1 then
                    else result = result .. "\n" end
                end
                result = result .. t
            end
            
            renderChunks(result)
            local newCur = chunkFrames[chunkData.index]
            if newCur then
                newCur.TextBox:CaptureFocus()
                newCur.TextBox.CursorPosition = curPos
            end
        end
    elseif input.KeyCode == Enum.KeyCode.Up then
        local before = tb.Text:sub(1, tb.CursorPosition - 1)
        if not before:find("\n") and chunkData.index > 1 then
            local prev = chunkFrames[chunkData.index - 1]
            prev.TextBox:CaptureFocus()
            prev.TextBox.CursorPosition = #prev.TextBox.Text + 1
        end
    elseif input.KeyCode == Enum.KeyCode.Down then
        local after = tb.Text:sub(tb.CursorPosition)
        if not after:find("\n") and chunkData.index < #chunkFrames then
            local nxt = chunkFrames[chunkData.index + 1]
            nxt.TextBox:CaptureFocus()
            nxt.TextBox.CursorPosition = 1
        end
    end
end

local function createChunkFrame(index, text, startingLine)
    local Frame = Instance.new("Frame")
    Frame.BackgroundTransparency = 1
    Frame.LayoutOrder = index
    Frame.Name = "Chunk_" .. index
    Frame.Parent = EditorScroll
    
    local LinesBox = Instance.new("TextLabel")
    LinesBox.Position = UDim2.new(0, 0, 0, 0)
    LinesBox.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    LinesBox.BorderSizePixel = 0
    LinesBox.TextColor3 = Color3.fromRGB(150, 150, 150)
    LinesBox.TextYAlignment = Enum.TextYAlignment.Top
    LinesBox.TextXAlignment = Enum.TextXAlignment.Right
    LinesBox.Font = Enum.Font.RobotoMono
    LinesBox.TextSize = 14
    LinesBox.ZIndex = 4
    LinesBox.Parent = Frame

    local LineDivider = Instance.new("Frame")
    LineDivider.Position = UDim2.new(0, 30, 0, 0)
    LineDivider.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
    LineDivider.BorderSizePixel = 0
    LineDivider.ZIndex = 4
    LineDivider.Parent = Frame
    
    local TextBox = Instance.new("TextBox")
    TextBox.TextXAlignment = Enum.TextXAlignment.Left
    TextBox.TextYAlignment = Enum.TextYAlignment.Top
    TextBox.TextSize = 14
    TextBox.TextColor3 = Color3.fromRGB(220, 220, 220) -- MATCHES ACTIVE BACKGROUND COLOR! Makes text invisible but allows native selection highlighting
    TextBox.TextTransparency = 0 
    TextBox.BackgroundTransparency = 1
    TextBox.Font = Enum.Font.RobotoMono
    TextBox.Position = UDim2.new(0, 35, 0, 0)
    TextBox.BorderSizePixel = 0
    TextBox.Text = text
    TextBox.TextWrapped = false
    TextBox.ClearTextOnFocus = false
    TextBox.MultiLine = true
    TextBox.TextEditable = true
    TextBox.ZIndex = 3 -- Set behind SyntaxLabel
    TextBox.LineHeight = 1
    TextBox.Parent = Frame
    
    local CursorFrame = Instance.new("Frame")
    CursorFrame.Size = UDim2.new(0, 1, 0, 14)
    CursorFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    CursorFrame.BorderSizePixel = 0
    CursorFrame.ZIndex = 5
    CursorFrame.Visible = false
    CursorFrame.Parent = Frame

    local function updateCursor()
        local textBeforeCursor = TextBox.Text:sub(1, TextBox.CursorPosition - 1)
        local newlines = 0
        for _ in textBeforeCursor:gmatch("\n") do newlines = newlines + 1 end
        
        local lastLineStart = textBeforeCursor:match(".*()\n")
        local currentLineText = ""
        if lastLineStart then
            currentLineText = textBeforeCursor:sub(lastLineStart)
        else
            currentLineText = textBeforeCursor
        end
        
        local xBounds = TextService:GetTextSize(currentLineText, 14, Enum.Font.RobotoMono, Vector2.new(10000, 10000))
        CursorFrame.Position = UDim2.new(0, xBounds.X + 35, 0, newlines * 14)
    end

    TextBox:GetPropertyChangedSignal("CursorPosition"):Connect(updateCursor)
    TextBox:GetPropertyChangedSignal("Text"):Connect(updateCursor)
    
    TextBox.Focused:Connect(function()
        Frame.BackgroundTransparency = 0.85
        Frame.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
        CursorFrame.Visible = true
        updateCursor()
    end)
    TextBox.FocusLost:Connect(function()
        Frame.BackgroundTransparency = 1
        CursorFrame.Visible = false
    end)
    
    -- Ensure blinking cursor animation
    task.spawn(function()
        while true do
            if CursorFrame.Visible then
                CursorFrame.BackgroundTransparency = (CursorFrame.BackgroundTransparency == 0) and 1 or 0
            end
            task.wait(0.5)
            if not CursorFrame.Parent then break end
        end
    end)
    
    local SyntaxLabel = Instance.new("TextLabel")
    SyntaxLabel.Position = UDim2.new(0, 35, 0, 0)
    SyntaxLabel.BackgroundTransparency = 1
    SyntaxLabel.TextXAlignment = Enum.TextXAlignment.Left
    SyntaxLabel.TextYAlignment = Enum.TextYAlignment.Top
    SyntaxLabel.Font = Enum.Font.RobotoMono
    SyntaxLabel.TextSize = 14
    SyntaxLabel.TextColor3 = Color3.fromRGB(50, 50, 50)
    SyntaxLabel.RichText = true
    SyntaxLabel.TextWrapped = false
    SyntaxLabel.Text = ""
    SyntaxLabel.ZIndex = 5
    SyntaxLabel.LineHeight = 1
    SyntaxLabel.Parent = Frame
    
    local chunkData = {
        index = index,
        Frame = Frame,
        TextBox = TextBox,
        SyntaxLabel = SyntaxLabel,
        LinesBox = LinesBox,
        LineDivider = LineDivider,
        startingLine = startingLine
    }
    
    updateChunkHighlighting(chunkData)
    
    TextBox.Focused:Connect(function()
        focusedTextBox = TextBox
        focusedChunk = chunkData
        Cursor.Parent = Frame
        Cursor.Visible = true
        SelectionContainer.Parent = Frame
    end)
    
    TextBox.FocusLost:Connect(function()
        if focusedTextBox == TextBox then
            Cursor.Visible = false
            task.delay(0.1, function()
                if focusedTextBox == TextBox then
                    focusedTextBox = nil
                    focusedChunk = nil
                    AutocompleteFrame.Visible = false
                end
            end)
        end
    end)
    
    TextBox:GetPropertyChangedSignal("CursorPosition"):Connect(function()
        if focusedTextBox == TextBox then
            updateCursor()
            updateSelection()
            pcall(checkAutocomplete)
        end
    end)
    
    TextBox:GetPropertyChangedSignal("SelectionStart"):Connect(function()
        if focusedTextBox == TextBox then updateSelection() end
    end)
    
    local lastText = text
    local skipNextTextChange = false

    TextBox:GetPropertyChangedSignal("Text"):Connect(function()
        if isRechunking or skipNextTextChange then 
            if skipNextTextChange then skipNextTextChange = false end
            lastText = TextBox.Text
            return 
        end
        
        local newText = TextBox.Text
        local pos = TextBox.CursorPosition
        
        -- TAB AND ENTER HANDLING
        if newText:find("\r") or newText:find("\t") then
            skipNextTextChange = true
            task.defer(function() skipNextTextChange = false end)
            local beforePos = newText:sub(1, pos - 1)
            local tabsBefore = select(2, beforePos:gsub("\t", ""))
            local returnsBefore = select(2, beforePos:gsub("\r", ""))
            
            newText = newText:gsub("\r", ""):gsub("\t", "    ")
            TextBox.Text = newText
            TextBox.CursorPosition = pos + (tabsBefore * 3) - returnsBefore
            lastText = newText
            return
        end

        -- AUTO-PAIR HANDLING
        local pairsMap = { ['"'] = '"', ["'"] = "'", ["("] = ")", ["["] = "]", ["{"] = "}" }
        local closeKeys = { ['"']=true, ["'"]=true, [")"]=true, ["]"]=true, ["}"]=true }
        
        if #newText == #lastText + 1 and pos > 1 then
            local charTyped = newText:sub(pos - 1, pos - 1)
            local nextCharInOldText = lastText:sub(pos - 1, pos - 1)
            
            if charTyped == nextCharInOldText and closeKeys[charTyped] then
                skipNextTextChange = true
                task.defer(function() skipNextTextChange = false end)
                TextBox.Text = lastText
                TextBox.CursorPosition = pos
                newText = lastText
            elseif pairsMap[charTyped] then
                skipNextTextChange = true
                task.defer(function() skipNextTextChange = false end)
                local before = newText:sub(1, pos - 1)
                local after = newText:sub(pos)
                newText = before .. pairsMap[charTyped] .. after
                TextBox.Text = newText
                TextBox.CursorPosition = pos
            end
        elseif #newText == #lastText - 1 then
            local charDeleted = lastText:sub(pos, pos)
            local nextChar = lastText:sub(pos + 1, pos + 1)
            if pairsMap[charDeleted] and nextChar == pairsMap[charDeleted] then
                skipNextTextChange = true
                task.defer(function() skipNextTextChange = false end)
                local before = newText:sub(1, pos - 1)
                local after = newText:sub(pos + 1)
                newText = before .. after
                TextBox.Text = newText
                TextBox.CursorPosition = pos
            end
        end
        
        lastText = newText
        
        local _, newlines = newText:gsub("\n", "")
        if newlines > CHUNK_LINES * 2 or #newText > 12000 then
            task.spawn(function() renderChunks(getFullText()) end)
        else
            updateChunkHighlighting(chunkData)
            updateAllLineNumbers()
        end
        
        if tabsData[currentTabIndex] then
            tabsData[currentTabIndex].content = getFullText()
        end
    end)
    
    TextBox.InputBegan:Connect(function(input)
        handleBoundary(input, chunkData)
    end)
    
    return chunkData
end

renderChunks = function(fullText)
    isRechunking = true
    for _, child in ipairs(EditorScroll:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("^Chunk_") then
            child:Destroy()
        end
    end
    chunkFrames = {}
    focusedTextBox = nil
    focusedChunk = nil
    Cursor.Visible = false
    SelectionContainer.Parent = nil
    AutocompleteFrame.Visible = false
    
    if fullText == "" then fullText = " " end
    local chunks = splitIntoChunks(fullText)
    
    local currentStartLine = 1
    for i, chunkText in ipairs(chunks) do
        local chunkData = createChunkFrame(i, chunkText, currentStartLine)
        table.insert(chunkFrames, chunkData)
        local _, newlines = chunkText:gsub("\n", "")
        currentStartLine = currentStartLine + newlines + 1
        -- Yield to prevent script exhaustion timeout on 100k+ lines
        if i % 10 == 0 then task.wait() end
    end
    
    isRechunking = false
    updateAllLineNumbers()
end

UserInputService.InputBegan:Connect(function(input)
    if focusedTextBox and AutocompleteFrame.Visible and #currentMatches > 0 then
        if input.KeyCode == Enum.KeyCode.Tab then
            local matchItem = currentMatches[1]
            local word, pos = getCurrentWord()
            if word then
                local text = focusedTextBox.Text
                local newText = text:sub(1, pos - #word - 1) .. matchItem.name .. text:sub(pos)
                task.spawn(function()
                    task.wait()
                    focusedTextBox.Text = newText
                    focusedTextBox:CaptureFocus()
                    focusedTextBox.CursorPosition = pos - #word + #matchItem.name
                    AutocompleteFrame.Visible = false
                end)
            end
        end
    end
end)

